# Expandr release / signing configuration.
#
# Sourced by the build + release scripts. Safe to commit: it contains only
# identifiers, never secrets. The notarization credential lives in the keychain
# (via `xcrun notarytool store-credentials`), and the Sparkle private key lives
# in the keychain too — neither is stored here.

# Product version shown to users and compared by Sparkle (independent of the
# espanso engine's own Cargo version). Bump this for each release.
EXPANDR_VERSION="1.1.2"

# The shipping app's bundle identifier (must stay stable across releases so that
# Accessibility permission and Sparkle updates keep working).
BUNDLE_ID="app.expandr"

# Apple Developer Team ID.
TEAM_ID="LZD89D88N5"

# Developer ID identities. The build script auto-detects these from
# `security find-identity` by their "Developer ID Application/Installer" prefix,
# so these are just documentation / an override if you have more than one.
DEVID_APP="Developer ID Application"
DEVID_INSTALLER="Developer ID Installer"

# notarytool stored-credentials profile name
# (created with: xcrun notarytool store-credentials "expandr-notary" \
#   --key AuthKey_XXXX.p8 --key-id <KEYID> --issuer <ISSUERID>)
NOTARY_PROFILE="expandr-notary"

# GitHub repo hosting releases + the Sparkle appcast.
GH_REPO="danielfyles/expandr"

# Sparkle auto-update. The public key is safe to commit; the matching private key
# lives in the login keychain (back it up — it signs every future update). The
# feed uses GitHub's "latest release" asset URL, so each release just ships an
# updated appcast.xml asset.
SPARKLE_FEED_URL="https://github.com/danielfyles/expandr/releases/latest/download/appcast.xml"
SPARKLE_PUBLIC_KEY="EbJS+u5Gwp+tw83HNJnNddDG4CmlBNrIZxQ7lLPwQOM="
